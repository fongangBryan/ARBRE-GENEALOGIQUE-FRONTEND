# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=genealogie_db

# JWT
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin
ADMIN_EMAIL=admin@genealogie.com
ADMIN_PASSWORD=Admin123!

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=genealogie-media

# Redis
REDIS_URL=redis://redis:6379/0

# 2FA
TOTP_ISSUER_NAME=GenealogieApp

# Email (console backend pour le dev — pas besoin d'un vrai serveur SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@genealogie.local
EMAIL_BACKEND=console

# Frontend URL (pour les liens dans les emails)
FRONTEND_URL=http://localhost:4200